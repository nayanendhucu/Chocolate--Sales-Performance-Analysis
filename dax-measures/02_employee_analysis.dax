-- ============================================
-- CHOCOLATE SALES PERFORMANCE ANALYSIS
-- Section 02: Employee Performance Analysis
-- ============================================


-- 1. Beverly's Total Sales
-- Calculates sales generated by Beverly Moffett.

Beverly Sales =
CALCULATE(
    [Total Amount],
    'Shipments'[Sales_Person] = "Beverie Moffett"
)


-- 2. Beverie's Bars Sales
-- Calculates Beverie's sales from the Bars category only.

Beverie Bars Sales =
CALCULATE(
    [Total Amount],
    'Shipments'[Sales Person] = "Beverie Moffett",
    'Products'[Category] = "Bars"
)


-- 3. Beverie's Sales Contribution
-- Calculates Beverly's percentage contribution
-- to the overall sales amount.

Beverly Sales Contribution =
DIVIDE(
    [Beverie  Toatal Sales],
    [Total Amount],
    0
)
