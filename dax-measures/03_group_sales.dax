-- ============================================
-- CHOCOLATE SALES PERFORMANCE ANALYSIS
-- Section 03: Group Sales Analysis
-- ============================================


-- 1. Total Sales of Group 1
-- Combines sales generated by four selected employees.
-- || represents the OR logical operator.

Total Sales Group 1 =
CALCULATE(
    [TOTAL AMOUNT],
    People[Sales_person] = "Dotty Strutley" ||
    People[Sales_person] = "Beverly Moffett" ||
    People[Sales_person] = "Brien Boise" ||
    People[Sales_person] = "Kaine Padly"
)


-- 2. Total Sales of Group 2
-- Combines sales generated by another four employees.

Total Sales Group 2 =
CALCULATE(
    [TOTAL AMOUNT],
    People[Sales_person] = "Andria Kimpton" ||
    People[Sales_person] = "Barr Faughny" ||
    People[Sales_person] = "Camilla Castle" ||
    People[Sales_person] = "Ches Bonnell"
)
